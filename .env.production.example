# Copie para .env.production.local. Este arquivo contém apenas placeholders.
# Runtime: pooler de transação para serverless; use connection_limit conforme o plano.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=3&pool_timeout=20&schema=colorimetry&sslmode=require"
# Migrações: conexão direta ou pooler em modo sessão (5432), nunca transação.
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?schema=colorimetry&sslmode=require"
BETTER_AUTH_URL="https://SEU_DOMINIO"
BETTER_AUTH_SECRET="GERAR_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES"
PORT="3000"
APP_ENV="production"
ALLOW_DEMO_SEED="false"
# Bootstrap administrativo: nunca usar o seed de desenvolvimento em produção.
PRODUCTION_ORGANIZATION_NAME=""
PRODUCTION_ADMIN_NAME=""
PRODUCTION_ADMIN_EMAIL=""
PRODUCTION_ADMIN_PASSWORD=""
